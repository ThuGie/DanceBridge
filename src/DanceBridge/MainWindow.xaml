<Window x:Class="DanceBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DanceBridge" Icon="Assets/dancebridge.ico" Width="1180" Height="850" MinWidth="1040" MinHeight="740" Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid Margin="20,28,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Accent}" HorizontalAlignment="Left"><Image Source="Assets/dancebridge-small.png" Width="40" Height="40"/></Border><TextBlock Text="DanceBridge" FontWeight="SemiBold" FontSize="20" Margin="0,16,0,4"/><TextBlock Text="CONTROLLER WORKSPACE" Foreground="{DynamicResource Muted}" FontSize="9"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,22,0,0"><TextBlock Text="ADAPTER PORTS" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,12"/><StackPanel x:Name="Ports"/></StackPanel>
<StackPanel Grid.Row="3"><TextBlock Text="TOOLS" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,0,0,10"/><Button Content="Driver setup" Click="Driver_Click" Margin="0,0,0,8"/><Button Content="Players &amp; game" Click="PlayerSettings_Click" Margin="0,0,0,8"/><Button Content="Mat health test" Click="Health_Click" Margin="0,0,0,8"/><Button Content="Diagnostics" Click="Diagnostics_Click" Margin="0,0,0,8"/><Button Content="Minimize to tray" Click="Tray_Click"/><TextBlock Text="GameCube USB adapters" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,22,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Your dance mat, connected." Foreground="{DynamicResource Heading}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Configure once. Step straight into your game." Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel><ComboBox x:Name="ThemeSelect" ToolTip="Color theme" Width="128" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,156,0" SelectionChanged="Theme_Changed"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="DDR"/></ComboBox><Button x:Name="Toggle" Content="Start output" Style="{StaticResource Primary}" Click="Toggle_Click" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="142"/></Grid>
<Border Grid.Row="1" Background="{DynamicResource StatusSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,24,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Text="Looking for adapter…" FontWeight="SemiBold"/><TextBlock x:Name="Destination" Text="Destination: all applications" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Detail" Foreground="{DynamicResource Muted}" FontSize="12" Text="Output paused · your mat can be tested safely" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource BadgeBackground}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock x:Name="OutputBadge" Text="PAUSED" Foreground="{DynamicResource BadgeText}" FontSize="10" FontWeight="SemiBold"/></Border></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource MatSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="PadTitle" Foreground="{DynamicResource Heading}" Text="Port 1 · Live input" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="PadSubtitle" Text="Press a panel to test. Click a tile to assign." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
<Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,22"><Grid x:Name="PadGrid" Width="300" Height="342"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="100"/><RowDefinition Height="100"/><RowDefinition Height="100"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid></Viewbox>
<StackPanel Grid.Row="2"><TextBlock x:Name="InputSummary" Text="No panels pressed" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="32" Margin="0,0,0,8"/><Button Content="Guided setup" Style="{StaticResource Primary}" Click="Setup_Click"/><TextBlock x:Name="MatLegend" Text="Held panels show PRESSED. The center is a rest area, not a button." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Grid></Border>
<Border Grid.Column="2" Background="{DynamicResource MappingSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Keyboard mapping" Foreground="{DynamicResource Heading}" FontSize="19" FontWeight="SemiBold"/><ComboBox x:Name="Port" Width="100" HorizontalAlignment="Right" SelectionChanged="Port_Changed"/></Grid>
<Grid Grid.Row="1" Margin="0,16,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProfileSelect" ToolTip="Profile library" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/><Button x:Name="SaveProfileButton" Grid.Column="1" Content="Save" Click="Save_Click" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Profiles" Click="ManageProfiles_Click" Margin="8,0,0,0"/></Grid>
<Grid Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="MAT INPUT" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Text="KEYBOARD KEY" FontSize="10" Foreground="{DynamicResource Muted}" Margin="100,0,0,0"/></Grid>
<ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="Mappings"/><Expander Header="Additional controller inputs" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"><StackPanel x:Name="ExtraMappings" Margin="0,12,0,0"/></Expander></StackPanel></ScrollViewer>
<Grid Grid.Row="4" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="Import profile" Click="Import_Click" Padding="12,8"/><Button Content="Export" Click="Export_Click" Margin="8,0,0,0" Padding="12,8"/></StackPanel></Grid></Grid></Border>
</Grid>
<Border Grid.Row="3" Background="{DynamicResource FooterSurface}" CornerRadius="8" Padding="14,11" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Hint" Text="Ready to configure. Output starts paused." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock Grid.Column="1" Text="Ctrl + Alt + P  ·  Pause" Foreground="{DynamicResource Muted}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
</Grid></Grid></Window>
