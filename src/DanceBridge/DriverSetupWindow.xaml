<Window x:Class="DanceBridge.DriverSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DanceBridge · Driver management" Width="700" Height="740" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<TextBlock Text="Adapter driver management" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Inspect, install, repair, roll back or remove the adapter driver." Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
<Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,20,0,16"><StackPanel><TextBlock x:Name="DeviceStatus" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DriverStatus" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/></StackPanel></Border>
<TextBlock x:Name="Explanation" TextWrapping="Wrap" LineHeight="21"/>
<WrapPanel Margin="0,18,0,10"><Button x:Name="RefreshButton" Content="Refresh detection" Click="Refresh_Click" Margin="0,0,8,8"/><Button x:Name="Install" Content="Install WinUSB" Click="Install_Click" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="Repair" Content="Repair WinUSB" Click="Repair_Click" Margin="0,0,8,8"/></WrapPanel>
<WrapPanel><Button x:Name="Rollback" Content="Roll back driver" Click="Rollback_Click" Margin="0,0,8,8"/><Button x:Name="Remove" Content="Remove adapter package" Click="Remove_Click" Margin="0,0,8,8"/></WrapPanel>
<TextBlock x:Name="RemovalReason" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
<TextBlock x:Name="Progress" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" MinHeight="70" Margin="0,12,0,12"/>
<Button Content="Close" Click="Close_Click" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></Window>
